import cv2
import numpy as np
import matplotlib.pyplot as plt
plt.rcParams['font.sans-serif'] = ['SimHei']
plt.rcParams['axes.unicode_minus'] = False
img=cv2.imread(r"E:\vscode\quzao.jpg")
img=cv2.cvtColor(img,cv2.COLOR_BGR2RGB)
img_1=cv2.blur(img,(7,7))
img_2=cv2.GaussianBlur(img,(7,7),100)
plt.figure(figsize=(12,4))
plt.subplot(1,3,1)
plt.title("噪声图")
plt.imshow(img)
plt.axis("off")
plt.subplot(1,3,2)
plt.title("均值滤波")
plt.imshow(img_1)
plt.axis("off")
plt.subplot(1,3,3)
plt.title("高斯滤波")
plt.imshow(img_2)
plt.axis("off")
plt.show()
