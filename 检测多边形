import cv2
import numpy as np
import matplotlib.pyplot as plt
plt.rcParams['font.sans-serif'] = ['SimHei']
plt.rcParams['axes.unicode_minus'] = False
img=cv2.imread(r"E:\vscode\jianceduobianxing.png")
img_rgb=cv2.cvtColor(img,cv2.COLOR_BGR2RGB)
imh_gray=cv2.cvtColor(img_rgb,cv2.COLOR_RGB2GRAY)
_,img_binary=cv2.threshold(imh_gray,0,255,cv2.THRESH_BINARY_INV+cv2.THRESH_OTSU)
contours,hierarchy=cv2.findContours(img_binary,cv2.RETR_EXTERNAL,cv2.CHAIN_APPROX_SIMPLE)
img_result=img_rgb.copy()
for cnt in contours:
    if cv2.contourArea(cnt)<500:
        continue
    perimeter=cv2.arcLength(cnt,True)
    approx=cv2.approxPolyDP(cnt,0.04*perimeter,True)
    x,y,w,h=cv2.boundingRect(approx)
    if len(approx)==3:
        cv2.putText(img_result,"三角形",(x,y-10),cv2.FONT_HERSHEY_SIMPLEX,0.5,(255,0,0),1)
        cv2.drawContours(img_result,[approx],-1,(0,255,0),2)
    elif len(approx)==4:
        approx_ratio=float(w)/h
        if 0.95<approx_ratio<1.05:
            cv2.putText(img_result,"正方形",(x,y-10),cv2.FONT_HERSHEY_SIMPLEX,0.5,(255,0,0),1)
            cv2.drawContours(img_result,[approx],-1,(0,255,0),2)
        else:
            cv2.putText(img_result,"矩形",(x,y-10),cv2.FONT_HERSHEY_SIMPLEX,0.5,(255,0,0),1)
            cv2.drawContours(img_result,[approx],-1,(0,255,0),2)
    else:
        continue
plt.figure(figsize=(10,5))
plt.title("检测结果")
plt.imshow(img_result)
plt.axis("off")
plt.show()